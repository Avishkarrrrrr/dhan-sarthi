# Google Gemini — reasoning engine (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sarvam AI — Indian-language voice (STT + TTS), ₹100 free credits: https://platform.sarvam.ai
SARVAM_API_KEY=

# Optional override of the LLM provider: bedrock | gemini | sarvam | fallback
# Leave blank for auto-selection (Bedrock if BEDROCK_MODEL_ID is set, else
# Gemini if a key is present, else fallback).
LLM_PROVIDER=

# --- Amazon Bedrock (in-VPC reasoning for the bank sandbox deployment) -------
# Bedrock uses the standard AWS credential chain (instance profile / task role
# on AWS, ~/.aws locally) — there is no API key.
#
# Setting BEDROCK_MODEL_ID is what opts into Bedrock. Anthropic ids on Bedrock
# carry an `anthropic.` prefix. Some regions, ap-south-1 included, expose the
# newer Claude models only through a cross-region inference profile — in that
# case use the `global.` form:
#   anthropic.claude-sonnet-5          (direct, in-region)
#   global.anthropic.claude-sonnet-5   (cross-region inference profile)
BEDROCK_MODEL_ID=

# Region for the Bedrock endpoint. Defaults to ap-south-1 (Mumbai).
AWS_REGION=

# Optional thinking/effort level: low | medium | high | xhigh | max
# Left blank deliberately — output_config is omitted unless set, so an
# unsupported param can never break the first call in a new environment.
BEDROCK_EFFORT=

# --- Customer 360° data source ------------------------------------------------
# Optional override: postgres | synthetic
# Leave blank for auto-selection (Postgres if DATABASE_URL is set, else the
# bundled synthetic demo personas).
DATA_SOURCE=

# Amazon RDS for PostgreSQL. Setting this opts into the Postgres repository.
# Apply db/schema.sql first:  psql "$DATABASE_URL" -f db/schema.sql
DATABASE_URL=

# Set to "require" for RDS, which terminates TLS with its own CA.
DATABASE_SSL=

# Connection pool ceiling per process. Default 5 — keep the total across all
# running tasks below the instance's max_connections.
DATABASE_POOL_MAX=
