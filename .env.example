# Sarvam AI — Indian-language voice (STT + TTS): https://platform.sarvam.ai
# Without this the advisor falls back to the browser's Web Speech, which is
# indistinguishable from success unless you check `engine` in the response.
SARVAM_API_KEY=

# Optional override of the LLM provider: bedrock | sarvam | fallback
# Leave blank for auto-selection: Bedrock when BEDROCK_MODEL_ID is set,
# else the deterministic fallback. Bedrock works only from the sandbox
# instance, whose role carries the grant — never from a laptop.
LLM_PROVIDER=

# Set on the instance only. Exactly one model is permitted by IDBI's policy.
BEDROCK_MODEL_ID=
AWS_REGION=ap-south-1
